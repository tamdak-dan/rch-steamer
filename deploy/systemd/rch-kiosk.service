# RCH Steamer HMI: starts the app full screen on the touchscreen at boot and
# restarts it within a few seconds if it ever stops.
# @USER@ is replaced by install.sh.

[Unit]
Description=RCH Steamer HMI (kiosk)
After=systemd-user-sessions.service rch-usb-update.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
# Skipped for one boot when a maintenance USB stick is plugged in.
ConditionPathExists=!/run/rch-maintenance

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# -s allows Ctrl+Alt+F2 console switching where it works; the dependable way
# to a login prompt is the maintenance USB stick (see deploy/UPDATING.md).
ExecStart=/usr/bin/cage -s -- /usr/local/bin/rch-kiosk-launch
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
