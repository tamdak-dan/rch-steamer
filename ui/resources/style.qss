/* ---------- MAIN WINDOW STYLES ----------  */
QMainWindow {
    font-family: __proj_font__;
    font-size: __B1-font-size__;
    color: __proj_font_color__;
    background-color: __main_bg_color__;
}

/* ---------- GLOBAL STYLES FOR ALL WIDGETS ----------  */
QLabel{
    font-family: __proj_font__;
    font-size: __B1-font-size__;
    color: __proj_font_color__;
}

QPushButton {
    font-family: __proj_font__;
    font-size: __H2-font-size__;
    color: __button_font_color__;
    background-color: __button_bg_neutral__;
    border: __button_border__;
    border-radius: __button_border_radius__;
} 


/* ---------- NAVIGATION BAR STYLES ----------  */
QWidget#NavigationWidget {
    font-family: __proj_font__;
    font-size: __H1-font-size__;
    background-color: __widget_bg_color__;
    border: __widget_border__;
    border-radius: 0px;
}

QWidget#NavigationWidget QPushButton {
    font-family: __proj_font__;
    font-size: __H2-font-size__;
    color: __proj_font_color__;
    background-color: __button_bg_neutral__;
    border: __button_border__;
    border-radius: __button_border_radius__;
} 

QLabel#PLC_sMachineState {
    padding: 4px 14px; border-radius: 12px;
    background-color: #555555; font-weight: bold;
}
QLabel#PLC_sMachineState[cat="run"]   { background-color: #1e8e3e; }
QLabel#PLC_sMachineState[cat="startup"] { background-color: #c77c00; }
QLabel#PLC_sMachineState[cat="fault"] { background-color: #c62828; }

QWidget#NavigationWidget QPushButton:checked {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
}

QLabel#ProjectTitle {
    font-size: __H1-font-size__;
    color: #ffffff;
}

/* steamer model under the title: small and grey so it reads as a fixed label, not a live value */
QLabel#lbl_SteamerModel {
    font-size: 13px;
    color: #c8c8c8;
}
QLabel#lbl_SteamerModel[warn="true"] {
    color: #ffd27a;
}

/* ---------- RUN SCREEN STYLES ----------  */
QWidget#RunPage {
    font-family: __proj_font__;
    font-size: __H1-font-size__;
    background-color: __widget_bg_color__;
    border: __widget_border__;
    border-radius: __widget_border_radius__;
}

QLabel#PLC_nSteamFlowMeasured { 
    font-size: 46px; 
    font-weight: bold;
    font-family: __proj_font__
}
QLabel#PLC_nSteamFlowStpt { 
    font-size: __B1-font-size__;
    font-family: __proj_font__
}

QSlider#horizontalSlider {
    min-height: 60px;                    /* overall touch target */
}
QSlider#horizontalSlider::groove:horizontal {
    height: 16px;
    border-radius: 8px;
    background: #555555;
}
QSlider#horizontalSlider::sub-page:horizontal {
    background: #2a82da;                 /* filled part, left of the handle */
    border-radius: 8px;
}
QSlider#horizontalSlider::handle:horizontal {
    width: 48px;
    height: 48px;
    margin: -16px 0;                     /* (handle 48 - groove 16) / 2, centers it */
    border-radius: 24px;                 /* half the width = circle */
    background: #ffffff;
    border: 2px solid #2a82da;
}

/* Unlocked, off */
QPushButton#PLC_bCmdSes {
    font-size: __B1-font-size__;
    background-color: __button_bg_color__;
    border: __button_border__;
}

/* Unlocked, on */
QPushButton#PLC_bCmdSes:checked {
    background-color: #00ca3d;
    border: __button_border_checked__;
}

/* Locked, off */
QPushButton#PLC_bCmdSes:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border: 2px dashed #555555;
}

/* Locked, on (e.g. system running, but the button can't be used in this state) */
QPushButton#PLC_bCmdSes:checked:disabled {
    background-color: #1f4f80;
    color: #aaaaaa;
    border: 2px dashed #555555;
}

/* Unlocked, off */
QPushButton#PLC_bCmdDelivery {
    font-size: __B1-font-size__;
    background-color: __button_bg_color__;
    border: __button_border__;
}

/* Unlocked, on */
QPushButton#PLC_bCmdDelivery:checked {
    background-color: #00ca3d;
    border: __button_border_checked__;
}

/* Locked, off */
QPushButton#PLC_bCmdDelivery:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border: 2px dashed #555555;
}

/* Locked, on (e.g. system running, but the button can't be used in this state) */
QPushButton#PLC_bCmdDelivery:checked:disabled {
    background-color: #1f4f80;
    color: #aaaaaa;
    border: 2px dashed #555555;
}

QTableWidget#tableWidget {
    font-size: __B2-font-size__;
    border-bottom: 1px solid #d0d0d0;
    padding: 0px 8px;
}

/* ---------- ALARM SCREEN STYLES ----------  */


/* ---------- MAINTENANCE SCREEN STYLES ----------  */
QWidget#MaintPage {
    font-family: __proj_font__;
    font-size: __H1-font-size__;
    background-color: __widget_bg_color__;
    border: __widget_border__;
    border-radius: __widget_border_radius__;
}

QLabel#lbl_MaintHint, QLabel#lbl_ValveNote {
    font-size: 14px;
    color: #e8e8e8;
}

/* Every maintenance toggle carries the dynamic property maint=true (set in the .ui),
   so one set of rules covers all of them. Same four states as the run page buttons. */

/* Unlocked, off */
QPushButton[maint="true"] {
    font-size: 16px;
    background-color: __button_bg_color__;
    border: __button_border__;
}

/* Unlocked, on */
QPushButton[maint="true"]:checked {
    background-color: #00ca3d;
    border: __button_border_checked__;
}

/* Locked, off */
QPushButton[maint="true"]:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border: 2px dashed #555555;
}

/* Locked, on */
QPushButton[maint="true"]:checked:disabled {
    background-color: #1f4f80;
    color: #aaaaaa;
    border: 2px dashed #555555;
}

QTableWidget#tbl_MaintReadings {
    font-size: __B2-font-size__;
    border-bottom: 1px solid #d0d0d0;
    padding: 0px 8px;
}

QTableWidget#tbl_MaintReadings::item {
    border-bottom: 1px solid #d0d0d0;
    padding: 0px 8px;
}

/* ---------- SYSTEM SCREEN STYLES ----------  */
QWidget#SystemPage {
    font-family: __proj_font__;
    font-size: __H1-font-size__;
    background-color: __widget_bg_color__;
    border: __widget_border__;
    border-radius: __widget_border_radius__;
}

QLabel#lbl_CurrentTime {
    font-size: 22px;
    font-weight: bold;
}

/* small helper / status text; status property is set from system_screen.py */
QLabel[hint="true"] {
    font-size: 14px;
    color: #e8e8e8;
}
QLabel[hint="true"][status="ok"]   { color: #9be7a8; }
QLabel[hint="true"][status="warn"] { color: #ffd27a; }

/* tappable value fields: look like inputs, open the touch keypad */
QPushButton[field="true"] {
    font-size: __B1-font-size__;
    color: #111111;
    background-color: #ffffff;
    border: __widget_border__;
    border-radius: __widget_border_radius__;
    text-align: left;
    padding-left: 10px;
}
QPushButton[field="true"]:pressed {
    border: 2px solid #2a82da;
}
QPushButton[field="true"]:disabled {
    color: #777777;
    background-color: #2a2a2a;
    border: 2px dashed #555555;
}

/* action buttons and the 25/50 model buttons: same four states as the maint toggles */
QPushButton[sys="true"] {
    font-size: 16px;
    background-color: __button_bg_color__;
    border: __button_border__;
}
QPushButton[sys="true"]:checked {
    background-color: #00ca3d;
    border: __button_border_checked__;
}
QPushButton[sys="true"]:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border: 2px dashed #555555;
}
QPushButton[sys="true"]:checked:disabled {
    background-color: #1f4f80;
    color: #aaaaaa;
    border: 2px dashed #555555;
}

/* ---------- TOUCH KEYPAD / CONFIRM DIALOGS ----------  */
QDialog#TouchDialog {
    background-color: __widget_bg_color__;
    border: 2px solid #ffffff;
    border-radius: __widget_border_radius__;
}
QLabel#td_Title {
    font-size: __H2-font-size__;
}
QLabel#td_Message {
    font-size: 16px;
}
QLabel#td_Display {
    font-size: 24px;
    color: #111111;
    background-color: #ffffff;
    border: __widget_border__;
    border-radius: __widget_border_radius__;
    padding: 0px 10px;
}
QPushButton#td_Key {
    font-size: 22px;
}
QPushButton#td_Ok {
    background-color: __button_bg_color__;
}
QPushButton#td_Ok:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border: 2px dashed #555555;
}
